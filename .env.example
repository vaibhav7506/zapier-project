# Database - required for primary-backend
DATABASE_URL="postgresql://user:password@localhost:5432/zapier?schema=public"

# JWT secret - MUST set a strong random value in production (min 32 chars)
JWT_PASSWORD="change-this-to-a-secure-random-string-in-production"

# Public Vercel URL used by QStash to invoke the signed queue handler
QSTASH_CALLBACK_URL="https://your-app.vercel.app"

# QStash credentials - copy from the QStash console
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Frontend public URLs. Leave unset when frontend, API, and webhooks share one Vercel domain.
# NEXT_PUBLIC_BACKEND_URL=https://your-app.vercel.app
# NEXT_PUBLIC_HOOKS_URL=https://your-app.vercel.app

# Required only for configured email actions
SMTP_ENDPOINT=""
SMTP_USERNAME=""
SMTP_PASSWORD=""

# Required only for configured Solana actions. Never expose this to the browser.
SOL_PRIVATE_KEY=""
